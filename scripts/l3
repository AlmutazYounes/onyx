#!/usr/bin/env bash
# Start L3: make sure the local model is up, build once if needed, then serve and open the app.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export PATH="$(brew --prefix node)/bin:/opt/homebrew/bin:$PATH"

if ! command -v ollama >/dev/null || ! command -v opencode >/dev/null; then
  echo "L3 is not set up yet; running scripts/l3-setup.sh first."
  "$ROOT/scripts/l3-setup.sh"
fi

if ! curl -fs http://127.0.0.1:11434/api/version >/dev/null; then
  brew services start ollama >/dev/null
  for _ in $(seq 1 30); do
    curl -fs http://127.0.0.1:11434/api/version >/dev/null && break
    sleep 1
  done
fi

if ! ollama show l3-coder >/dev/null 2>&1; then
  "$ROOT/scripts/l3-setup.sh"
fi

# Load the model now so the first prompt doesn't wait for 23 GB to come off disk.
curl -fs http://127.0.0.1:11434/api/generate \
  -d '{"model":"l3-coder","keep_alive":"30m"}' >/dev/null 2>&1 &

if [ ! -f "$ROOT/apps/server/dist/bin.mjs" ] || [ "${L3_REBUILD:-0}" = "1" ]; then
  echo "==> Building L3"
  (cd "$ROOT/apps/server" && "$ROOT/node_modules/.bin/vp" run build)
fi

if [[ " $* " != *" --port "* ]] && lsof -nP -iTCP:3873 -sTCP:LISTEN >/dev/null 2>&1; then
  echo "Port 3873 is in use, probably by the L3 desktop app. Quit it first; both share ~/.l3." >&2
  exit 1
fi

exec node "$ROOT/apps/server/dist/bin.mjs" "$@"
